        "PROVIDER",
        "CLIENT"
      ],
      "title": "NetworkElementClass",
      "type": "string"
    },
    "PacketIntent": {
      "description": "The category of a Packet, which decides how the receiver handles it.",
      "enum": [
        "DATA",
        "CONTROL",
        "REGISTRATION",
        "REGISTRATION_ACK",
        "PING",
        "ERROR"
      ],
      "title": "PacketIntent",
      "type": "string"
    },
    "Request": {
      "description": "The verb naming what a Packet asks for. Each verb has one Payload shape.",
      "enum": [
        "REGISTER",
        "ACKNOWLEDGE",
        "PING",
        "PONG",
        "GET_PROVIDERS",
        "GET_DEVICES",
        "GET_DEVICE_STRUCTURE",
        "CALL_OPERATION",
        "GET_PARAMETER",
        "SET_PARAMETER",
        "GET_INFO",
        "ERROR"
      ],
      "title": "Request",
      "type": "string"
    }
  },
  "envelope": {
    "$defs": {
      "PacketIntent": {
        "description": "The category of a Packet, which decides how the receiver handles it.",
        "enum": [
          "DATA",
          "CONTROL",
          "REGISTRATION",
          "REGISTRATION_ACK",
          "PING",
          "ERROR"
        ],
        "title": "PacketIntent",
        "type": "string"
      },
      "Request": {
        "description": "The verb naming what a Packet asks for. Each verb has one Payload shape.",
        "enum": [
          "REGISTER",
          "ACKNOWLEDGE",
          "PING",
          "PONG",
          "GET_PROVIDERS",
          "GET_DEVICES",
          "GET_DEVICE_STRUCTURE",
          "CALL_OPERATION",
          "GET_PARAMETER",
          "SET_PARAMETER",
          "GET_INFO",
          "ERROR"
        ],
        "title": "Request",
        "type": "string"
      }
    },
    "description": "The single message envelope on the wire. The Payload shape is fixed by `request`.",
    "properties": {
      "destination": {
        "title": "Destination",
        "type": "string"
      },
      "hops": {
        "default": 0,
        "title": "Hops",
        "type": "integer"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "intent": {
        "$ref": "#/$defs/PacketIntent"
      },
      "payload": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Payload"
      },
      "reply_to": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reply To"
      },
      "request": {
        "$ref": "#/$defs/Request"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "version": {
        "default": 2,
        "title": "Version",
        "type": "integer"
      }
    },
    "required": [
      "destination",
      "id",
      "intent",
      "request",
      "source",
      "version"
    ],
    "title": "Packet",
    "type": "object"
  },
