{
  "enums": {
    "ErrorCode": {
      "description": "Stable, machine-readable identifier in an error Payload.\n\nPeers branch on the code, never on the message text.",
      "enum": [
        "UNKNOWN_DESTINATION",
        "DESTINATION_UNREACHABLE",
        "MALFORMED_PACKET",
        "UNSUPPORTED_VERSION",
        "UNSUPPORTED_REQUEST",
        "WRONG_DESTINATION",
        "UNKNOWN_INSTRUMENT",
        "UNKNOWN_OPERATION",
        "UNKNOWN_PARAMETER",
        "INVALID_ARGUMENTS",
        "INSTRUMENT_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "NetworkElementClass": {
